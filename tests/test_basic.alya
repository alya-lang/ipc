## Test suite for ipc
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("ipc Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Endpoint Constructors & Validation
    # ═══════════════════════════════════════════════════════════
    let ep = pkg::loopback(19881)
    runner_assert_eq(r, ep.transport, pkg::IpcTransport.Loopback, "loopback transport == Loopback")
    runner_assert_str_eq(r, ep.host, "127.0.0.1", "loopback host is 127.0.0.1")
    runner_assert_eq(r, ep.port, 19881, "loopback port preserved")
    runner_assert_eq(r, ep.is_valid(), true, "loopback endpoint is valid")
    runner_assert_eq(r, pkg::endpoint_is_valid(ep), true, "endpoint_is_valid true for loopback")
    runner_assert_str_eq(r, ep.summary(), "127.0.0.1:19881", "endpoint summary host:port")

    let bad_port = pkg::loopback(0)
    runner_assert_eq(r, bad_port.is_valid(), false, "port 0 endpoint invalid")
    runner_assert_eq(r, pkg::endpoint_is_valid(null), false, "null endpoint invalid")

    let pipe_ep = pkg::endpoint_pipe("my-pipe")
    runner_assert_eq(r, pipe_ep.transport, pkg::IpcTransport.Pipe, "pipe transport == Pipe")
    runner_assert_eq(r, pipe_ep.is_valid(), true, "pipe endpoint with name is valid")
    runner_assert_str_eq(r, pipe_ep.summary(), "pipe:my-pipe", "pipe summary is pipe:name")

    let named_ep = pkg::pipe("orders")
    runner_assert_eq(r, named_ep.transport, pkg::IpcTransport.Pipe, "pipe() facade builds Pipe endpoint")
    runner_assert_str_eq(r, named_ep.path, "orders", "pipe() keeps channel name")

    let empty_pipe = pkg::pipe("")
    runner_assert_eq(r, empty_pipe.is_valid(), false, "empty pipe name is invalid")

    runner_assert_eq(r, pkg::IpcTransport.Loopback, 0, "IpcTransport.Loopback == 0")
    runner_assert_eq(r, pkg::IpcTransport.Pipe, 1, "IpcTransport.Pipe == 1")
    runner_assert_eq(r, pkg::IpcTransport.UnixSocket, 2, "IpcTransport.UnixSocket == 2")

    # ═══════════════════════════════════════════════════════════
    # 2. Message Constructors & Validation
    # ═══════════════════════════════════════════════════════════
    let txt = pkg::text_message("hello")
    runner_assert_eq(r, txt.kind, pkg::IpcKind.Text, "text message kind == Text")
    runner_assert_eq(r, txt.id, 0, "text message id == 0")
    runner_assert_str_eq(r, txt.payload, "hello", "text payload preserved")
    runner_assert_eq(r, txt.is_valid(), true, "text message valid")

    let null_txt = pkg::text_message(null)
    runner_assert_str_eq(r, null_txt.payload, "", "null payload becomes empty string")

    let req = pkg::new_request(7, "compute")
    runner_assert_eq(r, req.kind, pkg::IpcKind.Request, "request kind == Request")
    runner_assert_eq(r, req.id, 7, "request id preserved")
    runner_assert_eq(r, req.is_valid(), true, "request valid")

    let res = pkg::new_response(7, "done")
    runner_assert_eq(r, res.kind, pkg::IpcKind.Response, "response kind == Response")
    runner_assert_eq(r, res.id, 7, "response id preserved")

    runner_assert_eq(r, pkg::message_is_valid(null), false, "null message invalid")
    runner_assert_eq(r, pkg::IpcKind.Text, 0, "IpcKind.Text == 0")
    runner_assert_eq(r, pkg::IpcKind.Request, 1, "IpcKind.Request == 1")
    runner_assert_eq(r, pkg::IpcKind.Response, 2, "IpcKind.Response == 2")

    # ═══════════════════════════════════════════════════════════
    # 3. Frame Codec Roundtrips
    # ═══════════════════════════════════════════════════════════
    let wire = pkg::frame_encode("hello")
    runner_assert_str_eq(r, wire, "5:hello", "frame_encode prefixes length")

    let empty_wire = pkg::frame_encode("")
    runner_assert_str_eq(r, empty_wire, "0:", "frame_encode empty payload")

    let null_wire = pkg::frame_encode(null)
    runner_assert_str_eq(r, null_wire, "0:", "frame_encode null payload")

    let colon_wire = pkg::frame_encode("a:b:c")
    let colon_back, colon_rest = pkg::frame_decode(colon_wire)
    runner_assert_str_eq(r, colon_back, "a:b:c", "payload with colons roundtrips")
    runner_assert_str_eq(r, colon_rest, "", "no remainder after single frame")

    let p1, r1 = pkg::frame_decode("5:hello")
    runner_assert_str_eq(r, p1, "hello", "frame_decode extracts payload")
    runner_assert_str_eq(r, r1, "", "frame_decode remainder empty")

    let multi = pkg::frame_encode("one") + pkg::frame_encode("two")
    let first, after_first = pkg::frame_decode(multi)
    runner_assert_str_eq(r, first, "one", "first frame of pipelined buffer")
    let second, after_second = pkg::frame_decode(after_first)
    runner_assert_str_eq(r, second, "two", "second frame of pipelined buffer")
    runner_assert_str_eq(r, after_second, "", "buffer drained after two frames")

    # ═══════════════════════════════════════════════════════════
    # 4. Incomplete & Malformed Frames
    # ═══════════════════════════════════════════════════════════
    let inc1, inc_rest1 = pkg::frame_decode("12:short")
    runner_assert_eq(r, inc1 is null, true, "short buffer reports incomplete")
    runner_assert_str_eq(r, inc_rest1, "12:short", "incomplete buffer preserved")

    let inc2, inc_rest2 = pkg::frame_decode("no-colon-yet")
    runner_assert_eq(r, inc2 is null, true, "missing colon reports incomplete")

    let bad_seen = false
    try
        pkg::frame_decode("xx:hello")
    catch e
        bad_seen = true
    end
    runner_assert_eq(r, bad_seen, true, "non-numeric length prefix throws")

    # ═══════════════════════════════════════════════════════════
    # 5. Message Frame Roundtrip
    # ═══════════════════════════════════════════════════════════
    let mwire = pkg::frame_encode_message(req)
    let mback, mrest = pkg::frame_decode_message(mwire)
    runner_assert_eq(r, mback is null, false, "message frame decodes")
    runner_assert_eq(r, mback.kind, pkg::IpcKind.Request, "message kind survives codec")
    runner_assert_eq(r, mback.id, 7, "message id survives codec")
    runner_assert_str_eq(r, mback.payload, "compute", "message payload survives codec")
    runner_assert_str_eq(r, mrest, "", "message remainder empty")

    # ═══════════════════════════════════════════════════════════
    # 6. Statistics Counters
    # ═══════════════════════════════════════════════════════════
    let st = pkg::new_stats()
    runner_assert_eq(r, st.total(), 0, "fresh stats total == 0")
    st.record_sent()
    st.record_sent()
    st.record_received()
    st.record_error()
    runner_assert_eq(r, st.sent, 2, "sent counter == 2")
    runner_assert_eq(r, st.received, 1, "received counter == 1")
    runner_assert_eq(r, st.errors, 1, "error counter == 1")
    runner_assert_eq(r, st.total(), 3, "total == sent + received")

    # ═══════════════════════════════════════════════════════════
    # 7. TCP Loopback Roundtrip (single-threaded)
    # ═══════════════════════════════════════════════════════════
    let ports = [19881, 19882, 19883, 19884, 19885]
    let server = -1
    let bound = 0
    for p in ports
        let candidate = pkg::ipc_listen(p, 10)
        if candidate >= 0
            server = candidate
            bound = p
            break
        end
    end
    runner_assert(r, server >= 0, "loopback server bound to a test port")

    if server >= 0
        let client = pkg::ipc_connect("127.0.0.1", bound)
        runner_assert(r, client >= 0, "client connected to loopback server")

        let peer = pkg::ipc_accept(server, 2000)
        runner_assert(r, peer >= 0, "server accepted the connection")

        if client >= 0 and peer >= 0
            let sent = pkg::ipc_send(client, "hello-ipc")
            runner_assert(r, sent > 0, "client sent bytes")

            let got = pkg::ipc_recv(peer)
            runner_assert_str_eq(r, got, "hello-ipc", "server received payload")

            pkg::ipc_send(peer, "reply-ok")
            let back = pkg::ipc_recv(client)
            runner_assert_str_eq(r, back, "reply-ok", "client received reply")

            pkg::ipc_close(client)
            pkg::ipc_close(peer)
        end
        pkg::ipc_close(server)
    end

    # ═══════════════════════════════════════════════════════════
    # 8. Named Pipe Roundtrip (single-threaded)
    # ═══════════════════════════════════════════════════════════
    let bad_name_seen = false
    try
        pkg::ipc_pipe_listen("!!!")
    catch e
        bad_name_seen = true
    end
    runner_assert_eq(r, bad_name_seen, true, "pipe listen rejects unusable names")

    let pipe_server = pkg::ipc_pipe_listen("ipc-test-basic")
    runner_assert(r, pipe_server >= 0, "pipe listener opened")

    if pipe_server >= 0
        let pipe_client = pkg::ipc_pipe_connect("ipc-test-basic")
        runner_assert(r, pipe_client >= 0, "pipe client connected")

        let pipe_peer = pkg::ipc_pipe_accept(pipe_server, 2000)
        runner_assert(r, pipe_peer >= 0, "pipe server accepted")

        if pipe_client >= 0 and pipe_peer >= 0
            let pipe_sent = pkg::ipc_pipe_send(pipe_client, "hello-pipe:with:colons")
            runner_assert(r, pipe_sent > 0, "pipe client sent bytes")

            let pipe_got = pkg::ipc_pipe_recv(pipe_peer)
            runner_assert_str_eq(r, pipe_got, "hello-pipe:with:colons", "pipe server received payload")

            runner_assert_eq(r, pkg::ipc_pipe_poll(pipe_client, 100), 0, "no reply pending before server sends")

            pkg::ipc_pipe_send(pipe_peer, "reply-ok")
            runner_assert_eq(r, pkg::ipc_pipe_poll(pipe_client, 2000), 1, "reply readable via poll")

            let pipe_back = pkg::ipc_pipe_recv(pipe_client)
            runner_assert_str_eq(r, pipe_back, "reply-ok", "pipe client received reply")

            pkg::ipc_pipe_close(pipe_client)
            pkg::ipc_pipe_close(pipe_peer)
        end
        pkg::ipc_pipe_close(pipe_server)
    end

    # Rebinding the same name after close must succeed (stale cleanup).
    let pipe_rebind = pkg::ipc_pipe_listen("ipc-test-basic")
    runner_assert(r, pipe_rebind >= 0, "pipe name rebinds after close")
    if pipe_rebind >= 0
        pkg::ipc_pipe_close(pipe_rebind)
    end

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
