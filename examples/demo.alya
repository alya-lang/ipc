## Example usage and walkthrough for ipc
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

@cfg(feature = "framing")
function demo_messages()
    # ───────────────────────────────────────────────────────────
    # 1. Messages
    # ───────────────────────────────────────────────────────────
    say "--- 1. Messages ---"
    let req = pkg::new_request(7, "compute:6*7")
    say "Request:  " + req.summary()
    say "Payload:  " + req.payload
    say ""

end

@cfg(not(feature = "framing"))
function demo_messages()
end

@cfg(feature = "framing")
function demo_framing()
    # ───────────────────────────────────────────────────────────
    # 2. Wire Framing (pure, no network)
    # ───────────────────────────────────────────────────────────
    say "--- 2. Wire Framing ---"
    let wire = pkg::frame_encode("hello-ipc")
    say "Encoded:  " + wire
    let back, rest = pkg::frame_decode(wire)
    say "Decoded:  " + back + " (rest: \"" + rest + "\")"

    let req = pkg::new_request(7, "compute:6*7")
    let mwire = pkg::frame_encode_message(req)
    say "Msg wire: " + mwire
    let mback, mrest = pkg::frame_decode_message(mwire)
    say "Msg back: kind=" + str(mback.kind) + " id=" + str(mback.id) + " payload=" + mback.payload
    say ""

end

@cfg(not(feature = "framing"))
function demo_framing()
end

@cfg(feature = "tcp")
function demo_tcp()
    # ───────────────────────────────────────────────────────────
    # 3. Loopback Request/Reply (single-threaded echo)
    # ───────────────────────────────────────────────────────────
    say "--- 3. Loopback Request/Reply ---"
    let ep = pkg::loopback(19881)
    say "Endpoint: " + ep.summary()
    let ports = [19881, 19882, 19883, 19884, 19885]
    let server = -1
    let bound = 0
    for p in ports
        let candidate = pkg::ipc_listen(p, 10)
        if candidate >= 0
            server = candidate
            bound = p
            break
        end
    end
    if server < 0
        say "No test port available, skipping live demo."
    else
        say "Listening on 127.0.0.1:" + str(bound)
        let client = pkg::ipc_connect("127.0.0.1", bound)
        let peer = pkg::ipc_accept(server, 2000)
        if client >= 0 and peer >= 0
            pkg::ipc_send(client, "ping")
            let got = pkg::ipc_recv(peer)
            say "Server got: " + got
            pkg::ipc_send(peer, "pong:" + got)
            let reply = pkg::ipc_recv(client)
            say "Client got: " + reply
            pkg::ipc_close(client)
            pkg::ipc_close(peer)
        end
        pkg::ipc_close(server)
    end
    say ""

end

@cfg(not(feature = "tcp"))
function demo_tcp()
end

@cfg(feature = "pipe")
function demo_pipe()
    # ───────────────────────────────────────────────────────────
    # 4. Named Pipe Request/Reply (single-threaded echo)
    # ───────────────────────────────────────────────────────────
    say "--- 4. Named Pipe Request/Reply ---"
    let ep = pkg::pipe("ipc-demo")
    say "Endpoint: " + ep.summary()
    let pipe_server = pkg::ipc_pipe_listen("ipc-demo")
    if pipe_server < 0
        say "Pipe listener unavailable, skipping pipe demo."
    else
        let pipe_client = pkg::ipc_pipe_connect("ipc-demo")
        let pipe_peer = pkg::ipc_pipe_accept(pipe_server, 2000)
        if pipe_client >= 0 and pipe_peer >= 0
            pkg::ipc_pipe_send(pipe_client, "ping")
            let pipe_got = pkg::ipc_pipe_recv(pipe_peer)
            say "Pipe server got: " + pipe_got
            pkg::ipc_pipe_send(pipe_peer, "pong:" + pipe_got)
            say "Pipe client got: " + pkg::ipc_pipe_recv(pipe_client)
            pkg::ipc_pipe_close(pipe_client)
            pkg::ipc_pipe_close(pipe_peer)
        end
        pkg::ipc_pipe_close(pipe_server)
    end
    say ""

end

@cfg(not(feature = "pipe"))
function demo_pipe()
end

function main()
    say "=== ipc Package Showcase ==="
    say ""

    demo_messages()
    demo_framing()
    demo_tcp()
    demo_pipe()

    # ───────────────────────────────────────────────────────────
    # 5. Statistics
    # ───────────────────────────────────────────────────────────
    say "--- 5. Statistics ---"
    let st = pkg::new_stats()
    st.record_sent()
    st.record_received()
    say "Total ops: " + str(st.total()) + " (sent=" + str(st.sent) + " received=" + str(st.received) + ")"
    say ""
    say "Done!"
end

main()
