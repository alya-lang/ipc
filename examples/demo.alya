## Example usage and walkthrough for ipc
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== ipc Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Endpoints & Messages
    # ───────────────────────────────────────────────────────────
    say "--- 1. Endpoints & Messages ---"
    let ep = pkg::loopback(19881)
    say "Endpoint: " + ep.summary()

    let req = pkg::new_request(7, "compute:6*7")
    say "Request:  " + req.summary()
    say "Payload:  " + req.payload
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Wire Framing (pure, no network)
    # ───────────────────────────────────────────────────────────
    say "--- 2. Wire Framing ---"
    let wire = pkg::frame_encode("hello-ipc")
    say "Encoded:  " + wire
    let back, rest = pkg::frame_decode(wire)
    say "Decoded:  " + back + " (rest: \"" + rest + "\")"

    let mwire = pkg::frame_encode_message(req)
    say "Msg wire: " + mwire
    let mback, mrest = pkg::frame_decode_message(mwire)
    say "Msg back: kind=" + str(mback.kind) + " id=" + str(mback.id) + " payload=" + mback.payload
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Loopback Request/Reply (single-threaded echo)
    # ───────────────────────────────────────────────────────────
    say "--- 3. Loopback Request/Reply ---"
    let ports = [19881, 19882, 19883, 19884, 19885]
    let server = -1
    let bound = 0
    for p in ports
        let candidate = pkg::ipc_listen(p, 10)
        if candidate >= 0
            server = candidate
            bound = p
            break
        end
    end
    if server < 0
        say "No test port available, skipping live demo."
    else
        say "Listening on 127.0.0.1:" + str(bound)
        let client = pkg::ipc_connect("127.0.0.1", bound)
        let peer = pkg::ipc_accept(server, 2000)
        if client >= 0 and peer >= 0
            pkg::ipc_send(client, "ping")
            let got = pkg::ipc_recv(peer)
            say "Server got: " + got
            pkg::ipc_send(peer, "pong:" + got)
            let reply = pkg::ipc_recv(client)
            say "Client got: " + reply
            pkg::ipc_close(client)
            pkg::ipc_close(peer)
        end
        pkg::ipc_close(server)
    end
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Statistics
    # ───────────────────────────────────────────────────────────
    say "--- 4. Statistics ---"
    let st = pkg::new_stats()
    st.record_sent()
    st.record_received()
    say "Total ops: " + str(st.total()) + " (sent=" + str(st.sent) + " received=" + str(st.received) + ")"
    say ""
    say "Done!"
end

main()
