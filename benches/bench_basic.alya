## Benchmark suite for ipc
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("ipc Micro-Benchmarks")

    # Bench 1: frame_encode short payload - 100k iterations
    bench_start(runner, 100000)
    let i = 0
    while i < 100000
        pkg::frame_encode("hello-ipc")
        i += 1
    end
    bench_stop(runner, "frame_encode short 100k")

    # Bench 2: frame_decode short frame - 100k iterations
    bench_start(runner, 100000)
    let j = 0
    while j < 100000
        pkg::frame_decode("9:hello-ipc")
        j += 1
    end
    bench_stop(runner, "frame_decode short 100k")

    # Bench 3: message codec roundtrip - 50k iterations
    let req = pkg::new_request(7, "compute:6*7")
    bench_start(runner, 50000)
    let k = 0
    while k < 50000
        let wire = pkg::frame_encode_message(req)
        pkg::frame_decode_message(wire)
        k += 1
    end
    bench_stop(runner, "message codec 50k")

    # Bench 4: endpoint + message constructors - 100k iterations
    bench_start(runner, 100000)
    let m = 0
    while m < 100000
        let ep = pkg::loopback(19881)
        let msg = pkg::text_message("ping")
        ep.is_valid()
        msg.is_valid()
        m += 1
    end
    bench_stop(runner, "constructors 100k")

    bench_summary(runner)
end

main()
