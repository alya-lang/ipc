## ipc Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Primary public entry point for cross-process communication over TCP
## loopback with length-prefixed framing and one-shot request/reply.

import "./types.alya"
import "./core/frame.alya"
import "./core/channel.alya"
import "./core/pipe.alya"

# ───────────────────────────────────────────────────────────────
# Endpoint & Message Constructors
# ───────────────────────────────────────────────────────────────

## Creates a TCP loopback endpoint for the given port.
##
## ### Parameters
## - `port`: TCP port number (1-65535).
##
## ### Returns
## Initialized `IpcEndpoint`.
##
## ### Examples
## ```alya
## let ep = loopback(19881)
## ```
pub function loopback(port: int) -> IpcEndpoint
    return endpoint_loopback(port)
end

## Creates a plain text message with kind `Text` and id `0`.
##
## ### Parameters
## - `payload`: Text payload (null becomes "").
##
## ### Returns
## Initialized `IpcMessage`.
##
## ### Examples
## ```alya
## let msg = text_message("hello")
## ```
pub function text_message(payload) -> IpcMessage
    return message_text(payload)
end

## Creates a request message with the given correlation id.
##
## ### Parameters
## - `id`: Correlation id echoed back in the response.
## - `payload`: Text payload (null becomes "").
##
## ### Returns
## Initialized `IpcMessage` with kind `Request`.
pub function new_request(id: int, payload) -> IpcMessage
    return message_request(id, payload)
end

## Creates a response message answering the given correlation id.
##
## ### Parameters
## - `id`: Correlation id copied from the request.
## - `payload`: Text payload (null becomes "").
##
## ### Returns
## Initialized `IpcMessage` with kind `Response`.
pub function new_response(id: int, payload) -> IpcMessage
    return message_response(id, payload)
end

## Creates a zeroed statistics record.
##
## ### Returns
## `IpcStats` with all counters at 0.
pub function new_stats() -> IpcStats
    return stats_new()
end

## Creates a named-pipe endpoint for the given channel name.
##
## ### Parameters
## - `name`: Logical channel name (e.g. `"orders"`).
##
## ### Returns
## Initialized `IpcEndpoint` with transport `Pipe`.
##
## ### Examples
## ```alya
## let ep = pipe("orders")
## ```
pub function pipe(name: string) -> IpcEndpoint
    return endpoint_pipe(name)
end

## Sends a request to an endpoint and waits for a single reply.
##
## Routes by transport: pipe endpoints use the native pipe engine,
## anything else uses the TCP loopback channel. Opens a fresh
## connection per call (one frame each direction).
##
## ### Parameters
## - `ep`: Target `IpcEndpoint`.
## - `payload`: Request text payload.
## - `timeout_ms`: Per-operation wait in milliseconds (defaults to 5000).
##
## ### Returns
## Reply payload string.
##
## ### Examples
## ```alya
## let reply = request(pipe("orders"), "ping")
## ```
pub function request(ep, payload, timeout_ms: int = 5000) -> string
    if ep is not null and ep.transport == IpcTransport.Pipe
        return ipc_pipe_request(ep.path, payload, timeout_ms)
    end
    return ipc_request(ep, payload, timeout_ms)
end
