## ipc Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines endpoint, message, error, and statistics models for
## cross-process communication over TCP loopback (pipes and Unix
## sockets are reserved transports for future releases).

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Transport mechanism used by an endpoint.
##
## Only `Loopback` is wired in v0.1. `Pipe` and `UnixSocket` are
## reserved variants so configuration code can name them early.
pub enum IpcTransport
    Loopback = 0,
    Pipe = 1,
    UnixSocket = 2
end

## Logical kind of a message payload.
pub enum IpcKind
    Text = 0,
    Request = 1,
    Response = 2
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Network location of a peer.
##
## ### Fields
## - `transport`: Active `IpcTransport` value.
## - `host`: Host name or IP address (loopback transport only).
## - `port`: TCP port number (loopback transport only, 1-65535).
## - `path`: Channel name for the `Pipe` transport, empty otherwise.
pub struct IpcEndpoint
    transport: int,
    host: string,
    port: int,
    path: string
end

## Single framed message exchanged between processes.
##
## ### Fields
## - `kind`: Logical `IpcKind` value.
## - `id`: Correlation id matching requests to responses.
## - `payload`: Text payload (UTF-8 without NUL bytes in v0.1).
pub struct IpcMessage
    kind: int,
    id: int,
    payload: string
end

## Error thrown for invalid endpoints, failed connections, and I/O faults.
##
## ### Fields
## - `message`: Human-readable failure description.
## - `code`: Numeric failure category.
pub struct IpcError
    message: string,
    code: int
end

## Counters tracking sent, received, and failed operations.
##
## ### Fields
## - `sent`: Messages successfully sent.
## - `received`: Messages successfully received.
## - `errors`: Failed operations observed.
pub struct IpcStats
    sent: int,
    received: int,
    errors: int
end

# ───────────────────────────────────────────────────────────────
# Endpoint Constructors
# ───────────────────────────────────────────────────────────────

## Creates a TCP loopback endpoint for the given port.
##
## ### Parameters
## - `port`: TCP port number (1-65535).
##
## ### Returns
## Initialized `IpcEndpoint` with transport `Loopback`.
pub function endpoint_loopback(port: int) -> IpcEndpoint
    return IpcEndpoint { transport: IpcTransport.Loopback, host: "127.0.0.1", port: port, path: "" }
end

## Creates a named-pipe endpoint for the given channel name.
##
## The name keeps `[A-Za-z0-9_-]` characters (up to 32); the native engine
## strips the rest and maps it to a Windows named pipe or a POSIX Unix
## domain socket.
##
## ### Parameters
## - `name`: Logical channel name (e.g. `"orders"`).
##
## ### Returns
## Initialized `IpcEndpoint` with transport `Pipe`.
pub function endpoint_pipe(name: string) -> IpcEndpoint
    let n = name
    if n is null
        n = ""
    end
    return IpcEndpoint { transport: IpcTransport.Pipe, host: "", port: 0, path: n }
end

## Returns true when the endpoint carries a usable address.
##
## Loopback endpoints need a host and a port in 1-65535; pipe endpoints
## need a non-empty channel name.
##
## ### Parameters
## - `ep`: Endpoint to validate.
##
## ### Returns
## True for usable endpoints, else false.
pub function endpoint_is_valid(ep) -> bool
    if ep is null
        return false
    end
    if ep.transport == IpcTransport.Loopback
        if ep.host is null or ep.host == ""
            return false
        end
        if ep.port <= 0 or ep.port > 65535
            return false
        end
        return true
    end
    if ep.transport == IpcTransport.Pipe
        if ep.path is null or ep.path == ""
            return false
        end
        return true
    end
    return false
end

# ───────────────────────────────────────────────────────────────
# Message Constructors
# ───────────────────────────────────────────────────────────────

## Creates a plain text message with kind `Text` and id `0`.
##
## ### Parameters
## - `payload`: Text payload (null becomes "").
##
## ### Returns
## Initialized `IpcMessage`.
pub function message_text(payload) -> IpcMessage
    let body = payload
    if body is null
        body = ""
    end
    return IpcMessage { kind: IpcKind.Text, id: 0, payload: body }
end

## Creates a request message with the given correlation id.
##
## ### Parameters
## - `id`: Correlation id echoed back in the response.
## - `payload`: Text payload (null becomes "").
##
## ### Returns
## Initialized `IpcMessage` with kind `Request`.
pub function message_request(id: int, payload) -> IpcMessage
    let body = payload
    if body is null
        body = ""
    end
    return IpcMessage { kind: IpcKind.Request, id: id, payload: body }
end

## Creates a response message answering the given correlation id.
##
## ### Parameters
## - `id`: Correlation id copied from the request.
## - `payload`: Text payload (null becomes "").
##
## ### Returns
## Initialized `IpcMessage` with kind `Response`.
pub function message_response(id: int, payload) -> IpcMessage
    let body = payload
    if body is null
        body = ""
    end
    return IpcMessage { kind: IpcKind.Response, id: id, payload: body }
end

## Returns true when the message holds a known kind and a string payload.
##
## ### Parameters
## - `msg`: Message to validate.
##
## ### Returns
## True when valid, else false.
pub function message_is_valid(msg) -> bool
    if msg is null
        return false
    end
    if msg.kind != IpcKind.Text and msg.kind != IpcKind.Request and msg.kind != IpcKind.Response
        return false
    end
    if msg.payload is null
        return false
    end
    return true
end

# ───────────────────────────────────────────────────────────────
# Statistics Constructors
# ───────────────────────────────────────────────────────────────

## Creates a zeroed statistics record.
##
## ### Returns
## `IpcStats` with all counters at 0.
pub function stats_new() -> IpcStats
    return IpcStats { sent: 0, received: 0, errors: 0 }
end

## Returns the total number of completed operations (sent + received).
##
## ### Parameters
## - `self`: Statistics record to measure.
##
## ### Returns
## Sum of sent and received counters.
pub function IpcStats.total(self: IpcStats) -> int
    return self.sent + self.received
end

## Records one sent message.
##
## ### Parameters
## - `self`: Statistics record to update.
pub function IpcStats.record_sent(self: IpcStats)
    self.sent += 1
end

## Records one received message.
##
## ### Parameters
## - `self`: Statistics record to update.
pub function IpcStats.record_received(self: IpcStats)
    self.received += 1
end

## Records one failed operation.
##
## ### Parameters
## - `self`: Statistics record to update.
pub function IpcStats.record_error(self: IpcStats)
    self.errors += 1
end

# ───────────────────────────────────────────────────────────────
# Struct Methods
# ───────────────────────────────────────────────────────────────

## Returns a single-line summary of the endpoint.
##
## ### Parameters
## - `self`: The target `IpcEndpoint` instance.
##
## ### Returns
## Formatted `"host:port"` summary, or `"pipe:name"` for pipe endpoints.
pub function IpcEndpoint.summary(self: IpcEndpoint) -> string
    if self.transport == IpcTransport.Pipe
        return "pipe:{self.path}"
    end
    return "{self.host}:{self.port}"
end

## Returns true when this endpoint carries a usable address.
##
## ### Parameters
## - `self`: The target `IpcEndpoint` instance.
##
## ### Returns
## True when valid, else false.
pub function IpcEndpoint.is_valid(self: IpcEndpoint) -> bool
    return endpoint_is_valid(self)
end

## Returns a single-line summary of the message.
##
## ### Parameters
## - `self`: The target `IpcMessage` instance.
##
## ### Returns
## Formatted `"kind#id (n chars)"` summary.
pub function IpcMessage.summary(self: IpcMessage) -> string
    return "{self.kind}#{self.id} ({len(self.payload)} chars)"
end

## Returns true when this message holds a known kind and payload.
##
## ### Parameters
## - `self`: The target `IpcMessage` instance.
##
## ### Returns
## True when valid, else false.
pub function IpcMessage.is_valid(self: IpcMessage) -> bool
    return message_is_valid(self)
end
